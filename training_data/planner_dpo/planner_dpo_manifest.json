{
  "dataset_name": "vn_land_counsel_planner_dpo_v1",
  "version": 1,
  "status": "schema_ready",
  "purpose": "Direct preference optimization for globally correct Vietnamese legal terminology, relation framing, retrieval planning, and fact-grounded temporal intent",
  "target_records": 2000,
  "batch_size": 50,
  "target_batches": 40,
  "split_targets": {
    "train": 1600,
    "val": 200,
    "test": 200
  },
  "topic_targets": {
    "TRANSACTION": 400,
    "REGISTRATION": 300,
    "SANCTION": 300,
    "DISPUTE": 250,
    "LAND_USE": 250,
    "RECOVERY_COMPENSATION": 200,
    "AUTHORITY_PROCEDURE": 150,
    "ELIGIBILITY": 150
  },
  "difficulty_targets": {
    "EASY": 600,
    "MEDIUM": 700,
    "HARD": 700
  },
  "mutation_family_targets": {
    "TERM_TARGET_BOUNDARY": 400,
    "LEGAL_RELATION_FRAMING": 350,
    "QUERY_SEMANTIC_ALIGNMENT": 350,
    "COVERAGE_DECOMPOSITION": 300,
    "FACT_STATUS_GROUNDING": 250,
    "TEMPORAL_VERSION_INTENT": 150,
    "DEPENDENCY_SEQUENCE": 100,
    "CROSS_DOMAIN_BOUNDARY": 100
  },
  "term_target_boundary_subtypes": [
    "TARGET_KIND",
    "ISSUE_TYPE"
  ],
  "prompt_contract": {
    "version": 3,
    "source": "core/prompts/planning/__init__.py::DECOMPOSE_PROMPT",
    "system_prompt_sha256": "dd971109ef32ac30e9e798220988aeb20c31b78472b56784a819cffc18995e4a",
    "system_prompt_utf8_chars": 7195,
    "inject_at_compile_time": true
  },
  "model_contract": {
    "base_model_id": "Qwen/Qwen3-8B",
    "starting_adapter": "models/adapters/planner_qwen3_8b_lora/hf_adapter",
    "runtime_model_id": "Planner-Qwen3-8B-LoRA",
    "thinking_mode": false,
    "output_schema_source": "core/prompts/planning/__init__.py::PLANNER_JSON_SCHEMA"
  },
  "id_ownership": {
    "canonical_issue_id": "PYTHON_ASSIGNED_BY_POSITION",
    "canonical_requirement_id": "PYTHON_ASSIGNED_BY_ISSUE_AND_POSITION",
    "review_issue_key": "ANNOTATION_LOCAL_ALIGNMENT_KEY",
    "review_requirement_key": "ANNOTATION_LOCAL_ALIGNMENT_KEY",
    "fact_id": "COPIED_ONLY_FROM_INPUT_LEDGER",
    "dpo_pair_id": "PYTHON_ASSIGNED_AT_COMPILE_TIME"
  },
  "split_policy": {
    "group_key": "source_case_id",
    "rule": "GROUP_BY_SOURCE_CASE_ID",
    "max_pairs_per_source_case": 1,
    "planner_source_policy": "KEEP_ORIGINAL_PLANNER_SPLIT_FOR_TRAIN_AND_VAL",
    "test_source_policy": "INDEPENDENTLY_ADJUDICATED_WITHHELD_RAW_CASES_NOT_IN_PLANNER_GOLD_OR_PRIOR_PLANNER_TEST"
  },
  "source_policy": {
    "chosen": [
      "PLANNER_GOLD_V1",
      "INDEPENDENT_ADJUDICATION"
    ],
    "rejected": [
      "RUNTIME_PLANNER_8B",
      "BASE_QWEN3_8B",
      "SYNTHETIC_MINIMAL",
      "HISTORICAL_TRACE",
      "HUMAN_AUTHORED_HARD_NEGATIVE"
    ],
    "prefer_runtime_near_miss": true,
    "one_primary_error_family_per_pair": true,
    "minimal_contrast_required": true,
    "schema_valid_rejected_required": true
  },
  "legal_knowledge_policy": {
    "planner_must_not_answer_law": true,
    "article_clause_selection_allowed": false,
    "external_legal_source_required": false,
    "target": "legal terminology, relation framing, evidence target selection, query intent, fact linkage, and temporal intent only"
  },
  "review_contract": {
    "record_schema": "planner_dpo_record.schema.json",
    "annotation_stage": "gold_reviewed",
    "annotator": "GPT-5.6 Sol",
    "chosen_and_rejected_must_pass_planner_schema": true,
    "chosen_must_pass_full_semantic_contract": true,
    "rejected_must_violate_exactly_declared_semantic_family": true,
    "request_fact_ids_forbidden": true,
    "unsupported_status_assumptions_forbidden": true,
    "duplicate_query_within_plan_forbidden": true,
    "query_word_range": [8, 35],
    "query_safe_word_range": [18, 25],
    "query_max_chars": 220,
    "objective_word_range": [8, 24]
  },
  "output_targets": {
    "review_batches": "planner_dpo_review/labels/batch_001.yaml ... batch_040.yaml",
    "gold_jsonl": "planner_dpo_gold_2000.jsonl",
    "train_jsonl": "planner_dpo_train_1600.jsonl",
    "val_jsonl": "planner_dpo_val_200.jsonl",
    "test_jsonl": "planner_dpo_test_200.jsonl"
  },
  "notes": "DPO teaches the Planner to use legal terms and relations correctly. It does not teach substantive article or clause answers. Python injects the pinned prompt and assigns canonical IDs only after review validation."
}
